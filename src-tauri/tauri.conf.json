{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inboxed",
  "version": "0.1.0",
  "identifier": "dev.inboxed.app",
  "build": {
    "beforeDevCommand": "npm run build:engine && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:engine && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Inboxed",
        "width": 1200,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 28
        },
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/inboxed-engine"
    ]
  }
}
