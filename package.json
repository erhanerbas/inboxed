{
  "name": "inboxed",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:engine": "node scripts/build-engine.mjs",
    "test:engine": "cd engine && go test ./...",
    "test": "vitest run",
    "dev:engine": "cd engine && INBOXED_DATA_DIR=../.dev-data INBOXED_SEED=1 INBOXED_PORT=4321 INBOXED_TOKEN=dev INBOXED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420 go run ."
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/svelte": "^1.1.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
